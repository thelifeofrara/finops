# Postgres started by `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finops"
# Public URL of the app, used in login links
APP_URL="http://localhost:3000"
# SMTP for login links and reminders. Mailpit (from docker compose) catches everything locally: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@finops.local"
# Minutes between worker runs (reminders)
WORKER_INTERVAL_MINUTES="60"
